# Plantilla para producción en cPanel.
# En el servidor: cp .env.production.example .env  → rellena los valores → php artisan key:generate

APP_NAME=Bazaar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Dominio exacto con https. Sanctum lo usa para permitir el login del panel admin.
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=daily
LOG_LEVEL=error

# Base de datos MySQL creada en cPanel → "Bases de datos MySQL".
# cPanel antepone tu usuario a los nombres: p. ej. usuario_bazaar
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuario_bazaar
DB_USERNAME=usuario_bazaar
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Si el sitio también responde en www (o en otro dominio), añádelos separados por comas:
# SANCTUM_STATEFUL_DOMAINS=tudominio.com,www.tudominio.com

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

MAIL_MAILER=log
